diff --git a/spec/System/TestGemSelectControl_spec.lua b/spec/System/TestGemSelectControl_spec.lua
index 5535034f906caa9306e234fc9d6bef8f0105db16..d7dc3c2ce438d7b2d6f505fc046b7638abbde131 100644
--- a/spec/System/TestGemSelectControl_spec.lua
+++ b/spec/System/TestGemSelectControl_spec.lua
@@ -69,4 +69,118 @@ describe("GemSelectControl", function()
 		assert.are.equal("Arc", control.buf)
 		assert.are.same({ "Arc", true, nil, true }, getChange())
 	end)
+
+	describe("dropped-list hover", function()
+		local oldCursor, oldMain, oldPositive, oldNegative
+		before_each(function()
+			oldCursor = GetCursorPos
+			oldMain = { }
+			for _, key in ipairs({ "showThousandsSeparators", "thousandsSeparator", "decimalSeparator", "showFlavourText" }) do
+				oldMain[key] = main[key]
+			end
+			oldPositive, oldNegative = colorCodes.POSITIVE, colorCodes.NEGATIVE
+		end)
+		after_each(function()
+			_G.GetCursorPos = oldCursor
+			for _, key in ipairs({ "showThousandsSeparators", "thousandsSeparator", "decimalSeparator", "showFlavourText" }) do
+				main[key] = oldMain[key]
+			end
+			colorCodes.POSITIVE, colorCodes.NEGATIVE = oldPositive, oldNegative
+		end)
+
+		for _, imbued in ipairs({ false, true }) do
+			it("reuses hover content and refreshes changed inputs" .. (imbued and " for imbued supports" or " for gem slots"), function()
+				local control = makeControl()
+				local calls, draws, cursorY, drawY = 0, 0, 25
+				control.imbuedSelect = imbued
+				control.dropped = true
+				for i = 3, 20 do control.list[i] = "Default:Arc" end
+				control.EditControl = { Draw = function() end }
+				control.DrawControls = function() end
+				control.IsMouseOver = function() return true, control.dropped and "DROP" or "BODY" end
+				_G.GetCursorPos = function() return 10, cursorY end
+				control.skillsTab.displayGroup = { gemList = { } }
+				control.skillsTab.GetMouseOverControl = function() end
+				control.skillsTab.build.outputRevision = 1
+				control.skillsTab.build.calcsTab = { GetMiscCalculator = function() return function() end, { } end }
+				control.skillsTab.ProcessGemLevel = function(self, gem, isImbued) return isImbued and 1 or self.defaultGemLevel end
+				control.CalcOutputWithThisGem = function(self, calcFunc, gem, fullDPS)
+					calls = calls + 1
+					return { }
+				end
+				control.AddGemTooltip = function(self, gem, tooltip)
+					(tooltip or self.tooltip):AddLine(16, gem.nameSpec .. ":" .. gem.level .. ":" .. gem.quality)
+				end
+				control.skillsTab.build.AddStatComparesToTooltip = function(self, tooltip)
+					tooltip:AddLine(14, colorCodes.POSITIVE .. formatNumSep("12345.5"))
+				end
+				local function recordDraw(self, x, y)
+					draws = draws + 1
+					drawY = y
+				end
+				control.tooltip.Draw = recordDraw
+				if control.hoverTooltip then control.hoverTooltip.Draw = recordDraw end
+				local function frames(n)
+					for _ = 1, n do control:Draw({ x = 0, y = 0, width = 800, height = 600 }) end
+				end
+				frames(2)
+				assert.are.equal(0, calls)
+				frames(4)
+				assert.are.equal(1, calls)
+				assert.are.equal(4, draws)
+				local tooltip = control.hoverTooltip
+				assert.are.equal("Fireball:" .. (imbued and 1 or 20) .. ":0", tooltip.lines[1].text)
+				local original = copyTable(tooltip.lines, true)
+				control.dropped = false
+				frames(1)
+				control.dropped = true
+				frames(3)
+				assert.are.equal(1, calls)
+				assert.are.same(original, tooltip.lines)
+				local previousY = drawY
+				control.controls.scrollBar.offset = 2
+				frames(1)
+				assert.are.equal(previousY - 2, drawY)
+				assert.are.equal(1, calls)
+				cursorY = 42
+				frames(3)
+				assert.are.equal(2, calls)
+				assert.is_truthy(tooltip.lines[1].text:find("Arc", 1, true))
+				-- Sorting can replace the gem under the cursor without changing the row.
+				control.list[2] = "Default:Fireball"
+				frames(1)
+				assert.are.equal(3, calls)
+				assert.is_truthy(tooltip.lines[1].text:find("Fireball", 1, true))
+				local changes = {
+					function() control.skillsTab.build.outputRevision = 2 end,
+					function() control.sortCache = copyTable(control.sortCache) end,
+					function() control.skillsTab.defaultGemLevel = 19 end,
+					function() control.skillsTab.defaultGemQuality = 20 end,
+					function() control.skillsTab.sortGemsByDPSField = "FullDPS" end,
+					function() main.showThousandsSeparators = not main.showThousandsSeparators end,
+					function() main.thousandsSeparator = "_" end,
+					function() main.decimalSeparator = "," end,
+					function() colorCodes.POSITIVE = "^x123456" end,
+					function() colorCodes.NEGATIVE = "^x654321" end,
+					function() main.showFlavourText = not main.showFlavourText end,
+				}
+				for i, change in ipairs(changes) do
+					change()
+					frames(3)
+					assert.are.equal(3 + i, calls)
+					assert.are.equal(colorCodes.POSITIVE .. formatNumSep("12345.5"), tooltip.lines[#tooltip.lines].text)
+				end
+				-- An unavailable calculator must not leave an empty tooltip cached.
+				local getCalculator = control.skillsTab.build.calcsTab.GetMiscCalculator
+				control.skillsTab.build.calcsTab.GetMiscCalculator = function() end
+				control.skillsTab.build.outputRevision = 3
+				frames(1)
+				assert.are.equal(0, #tooltip.lines)
+				control.skillsTab.build.calcsTab.GetMiscCalculator = getCalculator
+				frames(3)
+				assert.are.equal(4 + #changes, calls)
+				assert.is_true(#tooltip.lines > 0)
+			end)
+		end
+	end)
 end)
