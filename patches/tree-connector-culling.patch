+-- Bounds cover every artwork state, including both halves of a split arc.
+-- Rebuilt with the connector geometry, including regenerated cluster subgraphs.
+function PassiveTreeClass:BuildConnectorBounds(connector)
+	local minX, minY, maxX, maxY = math.huge, math.huge, -math.huge, -math.huge
+	connector.bounds = nil
+	for _, vert in pairs(connector.vert) do
+		for i = 1, 8, 2 do
+			local x, y = vert[i], vert[i + 1]
+			-- Unknown geometry must stay on the original rendering path.
+			if not x or not y or x ~= x or y ~= y or math.abs(x) == math.huge or math.abs(y) == math.huge then
+				return
+			end
+			minX, minY = m_min(minX, x), m_min(minY, y)
+			maxX, maxY = m_max(maxX, x), m_max(maxY, y)
+		end
+	end
+	if minX <= maxX and minY <= maxY then
+		connector.bounds = { minX, minY, maxX, maxY }
+	end
+end
