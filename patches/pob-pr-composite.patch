diff --git a/src/Modules/CalcRelevance.lua b/src/Modules/CalcRelevance.lua
new file mode 100644
index 0000000000000000000000000000000000000000..33afd6822026480ed5044aa337d3f8c88fe609ab
--- /dev/null
+++ b/src/Modules/CalcRelevance.lua
@@ -0,0 +1,169 @@
+-- Path of Building
+-- Conservative, per-execution evidence for add-node calculation pruning.
+local calcs = require("Modules.CalcBase")
+local band = bit.band
+
+---@class CalcQueryObserver
+---@field active boolean
+---@field recorded boolean?
+---@field unsafe string?
+---@field queries table
+---@field nodes table
+local observer = { }
+observer.__index = observer
+
+function calcs.newQueryObserver()
+	return setmetatable({ active = true, queries = { }, nodes = { } }, observer)
+end
+
+function observer:Query(modType, flags, keywordFlags, source, ...)
+	if not self.active then
+		return
+	end
+	for i = 1, select("#", ...) do
+		local name = select(i, ...)
+		if name then
+			local signatures = self.queries[name]
+			if not signatures then
+				signatures = { }
+				self.queries[name] = signatures
+			end
+			local key = (modType or "*") .. ":" .. flags .. ":" .. keywordFlags
+			signatures[key] = { type = modType, flags = flags, keywordFlags = keywordFlags }
+		end
+	end
+end
+
+function observer:ObserveNodes(nodes)
+	-- This closure belongs to one calculation-local table, never to the live spec.
+	setmetatable(nodes, { __index = function(_, id)
+		if self.active and id ~= nil then
+			self.nodes[id] = true
+		end
+	end })
+end
+
+function observer:Seal()
+	self.active = false
+end
+
+local function matchesQuery(queries, mod)
+	for _, query in pairs(queries[mod.name] or { }) do
+		if (not query.type or query.type == mod.type) and band(query.flags, mod.flags) == mod.flags and MatchKeywordFlags(query.keywordFlags, mod.keywordFlags) then
+			return true
+		end
+	end
+	return false
+end
+
+local relevance = { }
+relevance.__index = relevance
+
+function calcs.newNodeRelevance(env, observation, output)
+	return setmetatable({
+		env = env, observation = observation, output = output, memo = { },
+		enabled = not observation.active and observation.recorded and not observation.unsafe,
+	}, relevance)
+end
+
+function relevance:IsIrrelevant(node)
+	if not self.enabled or type(node) ~= "table" then
+		return false
+	end
+	if self.memo[node] ~= nil then
+		return self.memo[node]
+	end
+	if self.observation.nodes[node.id] then
+		self.memo[node] = false
+		return false
+	end
+	local mods, grantsSkill, explodes = calcs.probeNodeContribution(self.env, node)
+	if not mods or grantsSkill or explodes then
+		return false
+	end
+	for _, mod in ipairs(mods) do
+		if matchesQuery(self.observation.queries, mod) then
+			self.memo[node] = false
+			return false
+		end
+	end
+	self.memo[node] = true
+	return true
+end
+
+local setupIndependence = { }
+setupIndependence.__index = setupIndependence
+
+-- Decides from an observeSetup observation whether a passive allocation change
+-- leaves item, gem requirement and active skill setup unchanged.
+function calcs.newSetupIndependence(env, observation)
+	return setmetatable({
+		env = env, observation = observation, memo = { },
+		enabled = not observation.active and not observation.unsafe,
+	}, setupIndependence)
+end
+
+function setupIndependence:IsIndependent(node)
+	if not self.enabled or type(node) ~= "table" then
+		return false
+	end
+	if self.memo[node] ~= nil then
+		return self.memo[node]
+	end
+	local independent = false
+	-- Setup reads sockets, keystones and tattoo counts directly rather than through queries.
+	if (node.type == "Normal" or node.type == "Notable" or node.type == "Mastery") and not node.isTattoo and not self.observation.nodes[node.id] then
+		local mods, grantsSkill, explodes = calcs.probeNodeContribution(self.env, node)
+		if mods and not grantsSkill and not explodes then
+			independent = true
+			for _, mod in ipairs(mods) do
+				-- Structured effects (such as ExtraJewelFunc, which reruns item setup from the
+				-- unobserved passive merge) can change setup without a recorded query.
+				if mod.type == "LIST" or matchesQuery(self.observation.queries, mod) then
+					independent = false
+					break
+				end
+			end
+		end
+	end
+	self.memo[node] = independent
+	return independent
+end
+
+function setupIndependence:Allows(override)
+	if not self.enabled or not override then
+		return false
+	end
+	local changed = false
+	for key, nodes in pairs(override) do
+		if key ~= "addNodes" and key ~= "removeNodes" then
+			return false
+		end
+		for node in pairs(nodes) do
+			if not self:IsIndependent(node) then
+				return false
+			end
+			changed = true
+		end
+	end
+	return changed
+end
+
+function relevance:CanSkip(override)
+	if not self.enabled or not override.addNodes or not next(override.addNodes) or override.removeNodes then
+		return false
+	end
+	for key in pairs(override) do
+		if key ~= "addNodes" then
+			return false
+		end
+	end
+	for node in pairs(override.addNodes) do
+		if not self:IsIrrelevant(node) then
+			return false
+		end
+	end
+	return true
+end
+
+return calcs
