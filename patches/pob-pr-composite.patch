new file mode 100644
index 0000000000000000000000000000000000000000..d0c828859c89e7e9d12ca9e3a5daa4ec874293b5
--- /dev/null
+++ b/src/Modules/CalcSetupReuse.lua
@@ -0,0 +1,122 @@
+-- Path of Building
+-- Conservative, execution-scoped reuse of item and skill calculation setup.
+local calcs = require("Modules.CalcBase")
+local t_insert = table.insert
+
+---@class SetupReuse
+---@field build Build
+---@field independence table Result of calcs.newSetupIndependence for the baseline setup.
+---@field specEnv CalcSpecEnv Reused environment and the item/skill acceleration that skips setup.
+---@field tables table[] Every table the baseline setup created that calculations receive, in discovery order.
+---@field contents table[] Post-setup shallow contents of `tables`, by the same index.
+local setupReuse = { }
+setupReuse.__index = setupReuse
+
+local setupReuseAcceleration = { requirementsItems = true, requirementsGems = true, skills = true }
+
+-- Mod objects are treated as immutable records once created. Calculation paths copy them
+-- before scaling, merging or adding source attribution, so they never need restoring.
+local function isMod(tbl)
+	return type(tbl.name) == "string" and type(tbl.flags) == "number" and type(tbl.keywordFlags) == "number"
+end
+
+-- Finds every table a setup created, reachable from `seed`, by pairing it with an
+-- independent setup of the same build position by position along values. Identical tables
+-- at a position are shared build, item, gem, tree or data tables that a fresh setup would
+-- use as well; differing tables were created by setup. A created table without a counterpart
+-- is collected but not descended.
+local function collectSetupTables(seed, twin)
+	local counterpart = { [seed] = twin }
+	local tables = { seed }
+	local index = 1
+	while tables[index] do
+		local tbl = tables[index]
+		index = index + 1
+		local other = counterpart[tbl]
+		if other then
+			for key, value in pairs(tbl) do
+				if type(value) == "table" and counterpart[value] == nil and not isMod(value) then
+					local otherValue = rawget(other, type(key) == "table" and counterpart[key] or key)
+					if otherValue ~= value then
+						counterpart[value] = type(otherValue) == "table" and otherValue
+						t_insert(tables, value)
+					end
+				end
+			end
+		end
+	end
+	return tables
+end
+
+-- Observes which modifiers item and skill setup reads and builds the baseline setup that
+-- passive-only calculations may reuse. Returns nil when setup changes its own override,
+-- cannot be replayed additively, or reads cached calculations from a previous environment.
+---@param build Build
+---@return SetupReuse? reuse
+function calcs.newSetupReuse(build)
+	local observation = calcs.newQueryObserver()
+	local seedOverride = { }
+	calcs.initEnv(build, "CALCULATOR", seedOverride, { observeSetup = true }, observation)
+	observation:Seal()
+	if seedOverride.conditions or (seedOverride.extraJewelFuncs and #seedOverride.extraJewelFuncs > 0) then
+		return nil
+	end
+	local capture = { }
+	local env, cachedPlayerDB, cachedEnemyDB, cachedMinionDB = calcs.initEnv(build, "CALCULATOR", nil, { captureSetup = capture })
+	if capture.unsafe or not capture.items or not capture.skills then
+		return nil
+	end
+	local mainSkill = env.player.mainSkill
+	if mainSkill and (mainSkill.skillData.triggeredByManaforged or mainSkill.activeEffect.grantedEffect.name == "Reflection") then
+		return nil
+	end
+	-- Calculations also receive the cached base databases (as Full DPS parents, which
+	-- ReplaceMod and ConvertMod can edit), so they belong to the restored state too.
+	local twin = { }
+	twin.env, twin.cachedPlayerDB, twin.cachedEnemyDB, twin.cachedMinionDB = calcs.initEnv(build, "CALCULATOR")
+	local tables = collectSetupTables({ env = env, cachedPlayerDB = cachedPlayerDB, cachedEnemyDB = cachedEnemyDB, cachedMinionDB = cachedMinionDB }, twin)
+	local contents = { }
+	for i, tbl in ipairs(tables) do
+		contents[i] = copyTable(tbl, true)
+	end
+	return setmetatable({
+		build = build,
+		independence = calcs.newSetupIndependence(env, observation),
+		specEnv = { env = env, cachedPlayerDB = cachedPlayerDB, cachedEnemyDB = cachedEnemyDB, cachedMinionDB = cachedMinionDB, accelerate = setupReuseAcceleration, reuseSetup = true, setupWrites = capture },
+		tables = tables,
+		contents = contents,
+	}, setupReuse)
+end
+
+function setupReuse:Allows(override)
+	return self.independence:Allows(override)
+end
+
+-- Returns every table the baseline setup created (except immutable mod objects) to its
+-- post-setup contents in place, preserving identity. Anything an earlier calculation wrote
+-- into or attached to them is discarded, so each reused calculation starts from the same
+-- state; shared build and data tables are left alone, as a fresh setup shares them too.
+function setupReuse:Restore()
+	local contents = self.contents
+	for i, tbl in ipairs(self.tables) do
+		local saved = contents[i]
+		for key in pairs(tbl) do
+			if saved[key] == nil then
+				tbl[key] = nil
+			end
+		end
+		for key, value in pairs(saved) do
+			tbl[key] = value
+		end
+	end
+end
+
+---@param override CalcOverride
+---@return Env, ModDB?, ModDB?, ModDB?
+function setupReuse:InitEnv(override)
+	self:Restore()
+	self.specEnv.env.override = override
+	return calcs.initEnv(self.build, "CALCULATOR", override, self.specEnv)
+end
+
+return calcs
