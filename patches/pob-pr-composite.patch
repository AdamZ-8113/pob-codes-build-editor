+			assert.equal("SELECTCHAR", tab.charImportMode)
+			assert.matches("Download failed", tab.charImportStatus)
+		end)
+
+		it("ignores responses after switching to another build", function()
+			tab:DownloadItems(realm, true)
+			newBuild()
