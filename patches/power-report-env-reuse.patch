+	local function findPlainNodes(count)
+		local candidates = { }
+		for _, node in pairs(build.spec.nodes) do
+			if not node.alloc and node.type == "Normal" and #node.modList == 1 and node.modList[1].name == "Dex" then
+				table.insert(candidates, node)
+			end
+		end
+		table.sort(candidates, function(a, b) return a.id < b.id end)
+		assert(#candidates >= count, "Not enough unallocated Dexterity passives")
+		return unpack(candidates, 1, count)
+	end
+
+	local function outputDifference(expected, actual, path, seen)
+		if expected == actual or (expected ~= expected and actual ~= actual) then
+			return nil
+		end
+		if type(expected) ~= "table" or type(actual) ~= "table" then
+			return path .. ": expected " .. tostring(expected) .. ", got " .. tostring(actual)
+		end
+		seen = seen or { }
+		seen[expected] = seen[expected] or { }
+		if seen[expected][actual] then
+			return nil
+		end
+		seen[expected][actual] = true
+		for key, value in pairs(expected) do
+			local difference = outputDifference(value, actual[key], path .. "." .. tostring(key), seen)
+			if difference then
+				return difference
+			end
+		end
+		for key, value in pairs(actual) do
+			if expected[key] == nil then
+				return path .. "." .. tostring(key) .. ": unexpected " .. tostring(value)
+			end
+		end
+	end
