@@ -0,0 +1,122 @@
+-- Path of Building
+-- Conservative, execution-scoped reuse of item and skill calculation setup.
+local calcs = require("Modules.CalcBase")
+local t_insert = table.insert
+
+---@class SetupReuse
+---@field build Build
+---@field independence table Result of calcs.newSetupIndependence for the baseline setup.
+---@field specEnv CalcSpecEnv Reused environment and the item/skill acceleration that skips setup.
+---@field tables table[] Every table the baseline setup created that calculations receive, in discovery order.
+---@field contents table[] Post-setup shallow contents of `tables`, by the same index.
+local setupReuse = { }
+setupReuse.__index = setupReuse
+
+local setupReuseAcceleration = { requirementsItems = true, requirementsGems = true, skills = true }
+
+-- Mod objects are treated as immutable records once created. Calculation paths copy them
+-- before scaling, merging or adding source attribution, so they never need restoring.
+local function isMod(tbl)
+	return type(tbl.name) == "string" and type(tbl.flags) == "number" and type(tbl.keywordFlags) == "number"
+end
+
+-- Finds every table a setup created, reachable from `seed`, by pairing it with an
+-- independent setup of the same build position by position along values. Identical tables
+-- at a position are shared build, item, gem, tree or data tables that a fresh setup would
+-- use as well; differing tables were created by setup. A created table without a counterpart
+-- is collected but not descended.
+local function collectSetupTables(seed, twin)
+	local counterpart = { [seed] = twin }
+	local tables = { seed }
+	local index = 1
+	while tables[index] do
+		local tbl = tables[index]
+		index = index + 1
+		local other = counterpart[tbl]
+		if other then
+			for key, value in pairs(tbl) do
+				if type(value) == "table" and counterpart[value] == nil and not isMod(value) then
+					local otherValue = rawget(other, type(key) == "table" and counterpart[key] or key)
+					if otherValue ~= value then
+						counterpart[value] = type(otherValue) == "table" and otherValue
