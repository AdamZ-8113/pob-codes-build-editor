+local setupIndependence = { }
+setupIndependence.__index = setupIndependence
+
+-- Decides from an observeSetup observation whether a passive allocation change
+-- leaves item, gem requirement and active skill setup unchanged.
+function calcs.newSetupIndependence(env, observation)
+	return setmetatable({
+		env = env, observation = observation, memo = { },
+		enabled = not observation.active and not observation.unsafe,
+	}, setupIndependence)
+end
+
+function setupIndependence:IsIndependent(node)
+	if not self.enabled or type(node) ~= "table" then
+		return false
+	end
+	if self.memo[node] ~= nil then
+		return self.memo[node]
+	end
+	local independent = false
+	-- Setup reads sockets, keystones and tattoo counts directly rather than through queries.
+	if (node.type == "Normal" or node.type == "Notable" or node.type == "Mastery") and not node.isTattoo and not self.observation.nodes[node.id] then
+		local mods, grantsSkill, explodes = calcs.probeNodeContribution(self.env, node)
+		if mods and not grantsSkill and not explodes then
+			independent = true
+			for _, mod in ipairs(mods) do
+				-- Structured effects (such as ExtraJewelFunc, which reruns item setup from the
+				-- unobserved passive merge) can change setup without a recorded query.
+				if mod.type == "LIST" or matchesQuery(self.observation.queries, mod) then
+					independent = false
+					break
+				end
+			end
+		end
+	end
+	self.memo[node] = independent
+	return independent
+end
+
+function setupIndependence:Allows(override)
+	if not self.enabled or not override then
+		return false
+	end
+	local changed = false
+	for key, nodes in pairs(override) do
+		if key ~= "addNodes" and key ~= "removeNodes" then
+			return false
+		end
+		for node in pairs(nodes) do
+			if not self:IsIndependent(node) then
+				return false
+			end
+			changed = true
+		end
+	end
+	return changed
+end
