 function relevance:CanSkip(override)
 	if not self.enabled or not override.addNodes or not next(override.addNodes) or override.removeNodes then
 		return false
 	end
 	for key in pairs(override) do
 		if key ~= "addNodes" then
 			return false
 		end
 	end
