+		local ringSlot = { id = -1, type = "Normal", modList = { modLib.createMod("AdditionalRingSlot", "FLAG", true) } }
+		local unused = { id = -2, type = "Normal", modList = { modLib.createMod("Unused", "BASE", 1) } }
+		local keystone = { id = -3, type = "Keystone", modList = { } }
