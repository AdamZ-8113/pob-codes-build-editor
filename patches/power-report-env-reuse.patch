+			assert.is_true(reuse:Allows(override), "Candidate " .. i .. " must reuse setup")
+			local env = reuse:InitEnv(override)
+			calcs.perform(env, true)
+			local fresh = calcs.initEnv(build, "CALCULATOR", copyTable(override, true))
+			calcs.perform(fresh, true)
+			local difference = outputDifference(fresh.player.output, env.player.output, "candidate " .. i)
+			assert(not difference, difference)
+			freshEnvs[i] = fresh
+		end
+		return freshEnvs
+	end
