+-- Limits a setup observation to the item and skill phases that a reused setup skips.
+local function setSetupObservation(specEnv, queryObserver, active)
+	if queryObserver and specEnv and specEnv.observeSetup then
+		queryObserver.active = active
+	end
+end
+
+-- Reused setup skips the item and skill phases, but wipeEnv still clears the player and
+-- enemy modifier databases those phases write to directly (for example Widowhail's
+-- multiplier and socket properties). A capturing setup records those writes once so a
+-- reused setup can replay them at the same point, preserving each modifier list's order.
+local setupPhaseDBs = { "modDB", "enemyDB" }
+
+local function markSetupPhase(specEnv, env)
+	if not (specEnv and specEnv.captureSetup) then
+		return nil
+	end
+	local mark = { }
+	for _, key in ipairs(setupPhaseDBs) do
+		local db = env[key]
+		local lists = { }
+		for name, list in pairs(db.mods) do
+			lists[name] = copyTable(list, true)
+		end
+		mark[key] = { lists = lists, conditions = copyTable(db.conditions, true), multipliers = copyTable(db.multipliers, true) }
+	end
+	return mark
+end
+
+local function captureSetupValues(capture, phase, current, previous)
+	local changed = { }
+	for key, value in pairs(current) do
+		if previous[key] ~= value then
+			changed[key] = value
+		end
+	end
+	for key in pairs(previous) do
+		if current[key] == nil then
+			capture.unsafe = phase .. " setup removed a condition or multiplier"
+		end
+	end
+	return changed
+end
+
+local function captureSetupPhase(specEnv, env, mark, phase)
+	if not mark then
+		return
+	end
+	local capture = specEnv.captureSetup
+	local writes = { }
+	for _, key in ipairs(setupPhaseDBs) do
+		local db, before = env[key], mark[key]
+		local added = { }
+		for name, previous in pairs(before.lists) do
+			local list = db.mods[name]
+			if not list or #list < #previous then
+				capture.unsafe = phase .. " setup removed modifiers"
+			end
+		end
+		for name, list in pairs(db.mods) do
+			local previous = before.lists[name] or { }
+			for i = 1, #previous do
+				if list[i] ~= previous[i] then
+					capture.unsafe = phase .. " setup replaced modifiers"
+				end
+			end
+			for i = #previous + 1, #list do
+				t_insert(added, list[i])
+			end
+		end
+		writes[key] = {
+			mods = added,
+			conditions = captureSetupValues(capture, phase, db.conditions, before.conditions),
+			multipliers = captureSetupValues(capture, phase, db.multipliers, before.multipliers),
+		}
+	end
+	if phase == "items" then
+		writes.explodeSources = copyTable(env.explodeSources, true)
+	end
+	capture[phase] = writes
+end
+
+local function replaySetupPhase(specEnv, env, phase)
+	local writes = specEnv and specEnv.reuseSetup and specEnv.setupWrites and specEnv.setupWrites[phase]
+	if not writes then
+		return
+	end
+	for _, key in ipairs(setupPhaseDBs) do
+		local db, write = env[key], writes[key]
+		db:AddList(write.mods)
+		for name, value in pairs(write.conditions) do
+			db.conditions[name] = value
+		end
+		for name, value in pairs(write.multipliers) do
+			db.multipliers[name] = value
+		end
+	end
+	if writes.explodeSources then
+		env.explodeSources = copyTable(writes.explodeSources, true)
+	end
+end
+
