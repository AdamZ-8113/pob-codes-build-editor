+-- functions granted by passives), or rewrote rather than added modifiers.
+local function prepareSetupReuse(build)
+	local observation = calcs.newQueryObserver()
+	local seedOverride = { }
+	calcs.initEnv(build, "CALCULATOR", seedOverride, { observeSetup = true }, observation)
+	observation:Seal()
+	if seedOverride.conditions or (seedOverride.extraJewelFuncs and #seedOverride.extraJewelFuncs > 0) then
+		return false
