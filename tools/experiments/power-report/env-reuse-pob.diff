+---@field reuseSetup boolean? Reuse item and skill setup for passive-only changes that cannot alter it.
+
+local setupReuseAcceleration = { requirementsItems = true, requirementsGems = true, skills = true }
+
+local function restoreTable(target, saved)
+	for key in pairs(target) do
+		if saved[key] == nil then
+			target[key] = nil
+		end
+	end
+	for key, value in pairs(saved) do
+		target[key] = value
+	end
+end
+
+-- Calculation passes write to the reused environment, actors and active skills (flags,
+-- conditions, messages, mirage and buff links) and can replace the main skill, so each
+-- reuse restores the post-setup state before setup runs again.
+local function snapshotSetupState(env)
+	local skills = { }
+	for _, activeSkill in ipairs(env.player.activeSkillList) do
+		local saved = { fields = copyTable(activeSkill, true), tables = { } }
+		for _, key in ipairs({ "skillFlags", "skillTypes", "skillCfg" }) do
+			if activeSkill[key] then
+				saved.tables[activeSkill[key]] = copyTable(activeSkill[key], true)
+			end
+		end
+		for _, cfg in ipairs({ activeSkill.skillCfg, activeSkill.weapon1Cfg, activeSkill.weapon2Cfg }) do
+			if cfg and cfg.skillCond then
+				saved.tables[cfg.skillCond] = copyTable(cfg.skillCond, true)
+			end
+		end
+		skills[activeSkill] = saved
+	end
+	return {
+		env = copyTable(env, true), player = copyTable(env.player, true), enemy = copyTable(env.enemy, true),
+		activeSkillList = copyTable(env.player.activeSkillList, true), skills = skills,
+	}
+end
+
+local function restoreSetupState(env, snapshot)
+	restoreTable(env, snapshot.env)
+	restoreTable(env.player, snapshot.player)
+	restoreTable(env.enemy, snapshot.enemy)
+	restoreTable(env.player.activeSkillList, snapshot.activeSkillList)
+	for activeSkill, saved in pairs(snapshot.skills) do
+		restoreTable(activeSkill, saved.fields)
+		for target, contents in pairs(saved.tables) do
+			restoreTable(target, contents)
+		end
+	end
+end
+
