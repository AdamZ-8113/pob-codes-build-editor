{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "pob-codes-import2",
  "compatibility_date": "2026-09-30",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": ".runtime/import2-release",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "pob.codes/import2*",
      "zone_name": "pob.codes"
    }
  ]
}
