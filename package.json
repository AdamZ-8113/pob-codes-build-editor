{
  "name": "pob-codes-build-editor",
  "version": "0.1.0",
  "private": true,
  "description": "A standalone browser build of Path of Building for PoB Codes.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18.0 <23",
    "npm": ">=10"
  },
  "packageManager": "npm@11.6.2",
  "scripts": {
    "prepare": "node scripts/prepare.mjs",
    "prepare:runtime": "node scripts/prepare.mjs",
    "dev": "node scripts/dev/dev.mjs",
    "pack": "node scripts/build/pack.mjs",
    "drift:upstream": "node scripts/build/upstream-drift.mjs",
    "clean:runtime": "node scripts/clean-runtime.mjs",
    "check": "node scripts/check.mjs",
    "test:unit": "node --test \"tests/unit/*.test.mjs\" && node scripts/test-deno-unit.mjs",
    "test:native": "node scripts/build/build-runtime.mjs --test",
    "test:browser": "node scripts/test-browser.mjs",
    "test:e2e": "playwright test",
    "test:e2e:release": "playwright test --config=playwright.release.config.mjs",
    "bench": "node tools/profiles/benchmark.mjs",
    "build:release": "node scripts/build/build-runtime.mjs --test && node scripts/build/pack.mjs && node scripts/release/materialize-import2.mjs && node scripts/release/create-release-record.mjs && node scripts/release/archive-release.mjs",
    "verify:release": "node scripts/release/verify-import2-release.mjs && node scripts/release/verify-release-record.mjs",
    "test:e2e:production-smoke": "node tools/profiles/profile-import2-production.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "sharp": "0.35.5"
  }
}
